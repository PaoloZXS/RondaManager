                  </button>
                  <button onClick={() => elimina(t.id)}>🗑️</button>
                </td>
              </tr>
            ))}
            {telefoni.length === 0 && (
              <tr>
                <td colSpan={5} style={{ textAlign: 'center', color: '#999' }}>
                  Nessun telefono configurato. I telefoni vengono registrati
                  automaticamente al primo invio dati.
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  );
}
