import 'dart:convert';
import '../models/configurazione.dart';
import 'crypto_service.dart';

/// Servizio per la decodifica del QR Code di configurazione.
class QrService {
  /// Decodifica e decifra il contenuto del QR Code,
  /// restituendo un oggetto Configurazione.
  static Future<Configurazione> decodificaQr(String qrContent) async {
    // Il QR contiene il JSON cifrato in Base64
    final decifrato = await CryptoServices.decryptQrConfig(qrContent);
    final json = jsonDecode(decifrato) as Map<String, dynamic>;
    return Configurazione.fromJson(json);
  }
}
