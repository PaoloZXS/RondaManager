import 'package:flutter/material.dart';
import 'package:provider/provider.dart';
import 'package:mobile_scanner/mobile_scanner.dart';
import '../providers/app_state.dart';
import '../services/qr_service.dart';

/// Schermata di scansione del QR Code di configurazione.
/// Mostrata al primo avvio o se la configurazione non è presente.
class QrScanScreen extends StatefulWidget {
  const QrScanScreen({super.key});

  @override
  State<QrScanScreen> createState() => _QrScanScreenState();
}

class _QrScanScreenState extends State<QrScanScreen> {
  bool _scansionando = true;

  @override
  void initState() {
    super.initState();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Configurazione App'),
      ),
      body: Consumer<AppState>(
        builder: (context, state, _) {
          if (state.caricamento) {
            return const Center(child: CircularProgressIndicator());
          }

          if (!_scansionando) {
            return _buildSuccessScreen(context, state);
          }

          return _buildScannerScreen(context, state);
        },
      ),
    );
  }

  Widget _buildScannerScreen(BuildContext context, AppState state) {
    return Column(
      children: [
        const Padding(
          padding: EdgeInsets.all(24.0),
          child: Column(
            children: [
              Icon(Icons.qr_code_scanner, size: 64, color: Colors.indigo),
              SizedBox(height: 16),
              Text(
                'Inquadra il QR Code di configurazione',
                textAlign: TextAlign.center,
                style: TextStyle(
                  fontSize: 20,
                  fontWeight: FontWeight.bold,
                ),
              ),
              SizedBox(height: 8),
              Text(
                'Il QR Code è stato generato dal pannello web '
                'e contiene tutti i dati necessari per configurare l\'app.',
                textAlign: TextAlign.center,
                style: TextStyle(color: Colors.grey),
              ),
            ],
          ),
        ),
        Expanded(
          child: MobileScanner(
            errorBuilder: (context, error, child) {
              return Center(
                child: Padding(
                  padding: const EdgeInsets.all(24.0),
                  child: Column(
                    mainAxisAlignment: MainAxisAlignment.center,
                    children: [
                      const Icon(Icons.error_outline, size: 64, color: Colors.red),
                      const SizedBox(height: 16),
                      Text(
                        'Errore fotocamera: $error',
                        textAlign: TextAlign.center,
                        style: const TextStyle(color: Colors.red, fontSize: 16),
                      ),
                      const SizedBox(height: 24),
                      ElevatedButton.icon(
                        onPressed: () => setState(() {}),
                        icon: const Icon(Icons.refresh),
                        label: const Text('Riprova'),
                      ),
                    ],
                  ),
                ),
              );
            },
            onDetect: (capture) async {
              if (capture.barcodes.isEmpty) return;

              final barcode = capture.barcodes.first;
              final rawValue = barcode.rawValue;
              if (rawValue == null || rawValue.isEmpty) return;

              setState(() => _scansionando = false);

              try {
                final config = await QrService.decodificaQr(rawValue);
                if (!mounted) return;
                await state.salvaConfigurazione(config);
              } catch (e) {
                if (!mounted) return;
                ScaffoldMessenger.of(context).showSnackBar(
                  SnackBar(
                    content: Text('Errore decodifica QR: $e'),
                    backgroundColor: Colors.red,
                  ),
                );
                setState(() => _scansionando = true);
              }
            },
          ),
        ),
        Padding(
          padding: const EdgeInsets.all(16.0),
          child: Text(
            'Assicurati che il QR Code sia ben illuminato e a fuoco.',
            style: TextStyle(color: Colors.grey[600]),
          ),
        ),
      ],
    );
  }

  Widget _buildSuccessScreen(BuildContext context, AppState state) {
    return Center(
      child: Padding(
        padding: const EdgeInsets.all(32.0),
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            const Icon(
              Icons.check_circle_outline,
              size: 80,
              color: Colors.green,
            ),
            const SizedBox(height: 24),
            const Text(
              'Configurazione completata!',
              style: TextStyle(
                fontSize: 22,
                fontWeight: FontWeight.bold,
              ),
            ),
            const SizedBox(height: 16),
            if (state.configurazione != null) ...[
              Text(
                'Telefono: ${state.configurazione!.idTelefono}',
                style: const TextStyle(fontSize: 16),
              ),
              Text(
                'Guardie configurate: ${state.configurazione!.guardie.length}',
                style: const TextStyle(fontSize: 16),
              ),
              Text(
                'Percorsi configurati: ${state.configurazione!.percorsi.length}',
                style: const TextStyle(fontSize: 16),
              ),
            ],
            const SizedBox(height: 24),
            ElevatedButton(
              onPressed: () {
                // Ricarica per passare alla schermata di login
                Navigator.of(context).pushReplacement(
                  MaterialPageRoute(
                    builder: (_) => const _RebuildWidget(),
                  ),
                );
              },
              style: ElevatedButton.styleFrom(
                padding: const EdgeInsets.symmetric(
                  horizontal: 48,
                  vertical: 16,
                ),
              ),
              child: const Text('Continua'),
            ),
          ],
        ),
      ),
    );
  }
}

/// Widget helper per forzare il rebuild del widget principale.
class _RebuildWidget extends StatelessWidget {
  const _RebuildWidget();

  @override
  Widget build(BuildContext context) {
    return const SizedBox.shrink();
  }
}
