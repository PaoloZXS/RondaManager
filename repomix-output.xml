import { useEffect, useState } from 'react';
import { getSupabaseClient } from '../services/supabase';

export default function Dashboard() {
  const [stats, setStats] = useState({
    guardie: 0,
    punti: 0,
    percorsi: 0,
    turni: 0,
  });

  useEffect(() => {
    caricaStatistiche();
  }, []);

  async function caricaStatistiche() {
    try {
      const supabase = getSupabaseClient();
      const [{ count: g }, { count: p }, { count: pe }, { count: t }] =
        await Promise.all([
          supabase.from('guardie').select('*', { count: 'exact', head: true }),
          supabase.from('punti_controllo').select('*', { count: 'exact', head: true }),
          supabase.from('percorsi').select('*', { count: 'exact', head: true }),
          supabase.from('turni').select('*', { count: 'exact', head: true }),
        ]);

      setStats({
        guardie: g ?? 0,
        punti: p ?? 0,
        percorsi: pe ?? 0,
        turni: t ?? 0,
      });
    } catch (err) {
      console.error('Errore caricamento statistiche:', err);
    }
  }

  return (
    <div>
      <h1>Dashboard</h1>
      <p style={{ color: '#666', marginBottom: 24 }}>
        Panoramica del sistema RondaManager
      </p>

      <div className="stats-grid" style={{
        display: 'grid',
        gridTemplateColumns: 'repeat(auto-fit, minmax(200px, 1fr))',
        gap: 16,
      }}>
        {[
          { label: 'Guardie', value: stats.guardie, icon: '👤', color: '#1a237e' },
          { label: 'Punti Controllo', value: stats.punti, icon: '📍', color: '#2e7d32' },
          { label: 'Percorsi', value: stats.percorsi, icon: '🗺️', color: '#e65100' },
          { label: 'Turni', value: stats.turni, icon: '🕐', color: '#6a1b9a' },
