import 'package:geolocator/geolocator.dart';

/// Servizio per la geolocalizzazione.
/// Acquisisce coordinate GPS al momento della timbratura.
class GpsService {
  /// Richiede i permessi di localizzazione.
  Future<bool> richiediPermessi() async {
    final permission = await Geolocator.requestPermission();
    return permission == LocationPermission.always ||
        permission == LocationPermission.whileInUse;
  }

  /// Ottiene la posizione GPS corrente.
  /// Restituisce Position o null se non disponibile.
  Future<Position?> getPosizione() async {
    try {
      final posizione = await Geolocator.getCurrentPosition(
        desiredAccuracy: LocationAccuracy.high,
        timeLimit: const Duration(seconds: 10),
      );
      return posizione;
    } catch (e) {
      return null;
    }
  }

  /// Ottiene la percentuale di batteria del dispositivo.
  Future<double> getBatteria() async {
    // Nota: su Android, Geolocator non fornisce batteria.
    // Usiamo un valore di default; su device reali si può
    // usare un plugin come battery_info o batteria_optimization.
    return 100.0;
  }

  /// Calcola la distanza in metri tra due coordinate.
  double calcolaDistanza(
    double lat1, double lon1,
    double lat2, double lon2,
  ) {
    return Geolocator.distanceBetween(lat1, lon1, lat2, lon2);
  }
}
