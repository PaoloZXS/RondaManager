import { useEffect, useState } from 'react';
import { getSupabaseClient } from '../services/supabase';
import type { Guardia } from '../types';

export default function GuardiePage() {
  const [guardie, setGuardie] = useState<Guardia[]>([]);
  const [form, setForm] = useState({ nome: '', cognome: '', pin: '' });
  const [editingId, setEditingId] = useState<string | null>(null);
  const [showForm, setShowForm] = useState(false);
  const [mostraPin, setMostraPin] = useState(false);

  useEffect(() => {
    caricaGuardie();
  }, []);

  async function caricaGuardie() {
    const supabase = getSupabaseClient();
    const { data } = await supabase.from('guardie').select('*');
    if (data) setGuardie(data);
  }

  async function salvaGuardia() {
    const supabase = getSupabaseClient();
    if (editingId) {
      await supabase.from('guardie').update(form).eq('id', editingId);
    } else {
      await supabase.from('guardie').insert({
        ...form,
        id: crypto.randomUUID(),
      });
    }
    setForm({ nome: '', cognome: '', pin: '' });
    setEditingId(null);
    setShowForm(false);
    caricaGuardie();
  }

  function modifica(g: Guardia) {
    setForm({ nome: g.nome, cognome: g.cognome, pin: g.pin });
    setEditingId(g.id);
    setShowForm(true);
  }

  async function elimina(id: string) {
    if (!confirm('Eliminare questa guardia?')) return;
    const supabase = getSupabaseClient();
    await supabase.from('guardie').delete().eq('id', id);
    caricaGuardie();
  }

  return (
    <div>
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 24 }}>
        <h1>Guardie</h1>
        <button className="btn-primary" onClick={() => { setShowForm(!showForm); setEditingId(null); setForm({ nome: '', cognome: '', pin: '' }); }}>
          {showForm ? 'Annulla' : '+ Nuova Guardia'}
        </button>
      </div>

      {showForm && (
        <div className="card" style={{ marginBottom: 24 }}>
          <h3>{editingId ? 'Modifica Guardia' : 'Nuova Guardia'}</h3>
          <div style={{ display: 'flex', gap: 16, flexDirection: 'column' }}>
            <div style={{ display: 'flex', gap: 12, flexWrap: 'wrap' }}>
              <div style={{ flex: 1, minWidth: 180 }}>
                <label style={{ display: 'block', marginBottom: 4, fontWeight: 500, fontSize: 14, color: '#555' }}>
                  Nome Sorvegliante
                </label>
                <input
                  placeholder="es. Mario"
                  value={form.nome}
                  onChange={(e) => setForm({ ...form, nome: e.target.value })}
                  style={{ width: '100%', padding: 10, border: '1px solid #ddd', borderRadius: 8, boxSizing: 'border-box' }}
                />
              </div>
              <div style={{ flex: 1, minWidth: 180 }}>
                <label style={{ display: 'block', marginBottom: 4, fontWeight: 500, fontSize: 14, color: '#555' }}>
                  Cognome
                </label>
                <input
                  placeholder="es. Rossi"
                  value={form.cognome}
                  onChange={(e) => setForm({ ...form, cognome: e.target.value })}
                  style={{ width: '100%', padding: 10, border: '1px solid #ddd', borderRadius: 8, boxSizing: 'border-box' }}
                />
              </div>

              <div style={{ flex: '0 0 140px' }}>
                <label style={{ display: 'block', marginBottom: 4, fontWeight: 500, fontSize: 14, color: '#555' }}>
                  PIN
                </label>
                <div style={{ position: 'relative' }}>
                  <input
                    placeholder="0000"
                    value={form.pin}
                    onChange={(e) => setForm({ ...form, pin: e.target.value })}
                    type={mostraPin ? 'text' : 'password'}
                    maxLength={6}
                    style={{ width: '100%', padding: '10px 40px 10px 10px', border: '1px solid #ddd', borderRadius: 8, boxSizing: 'border-box' }}
                  />
                  <span
                    onClick={() => setMostraPin(!mostraPin)}
                    style={{
                      position: 'absolute',
                      right: 8,
                      top: '50%',
                      transform: 'translateY(-50%)',
                      cursor: 'pointer',
                      userSelect: 'none',
                      fontSize: 18,
                    }}
                  >
                    {mostraPin ? '👁️' : '👁️‍🗨️'}
                  </span>
                </div>
              </div>
            </div>
            <div>
              <button className="btn-primary" onClick={salvaGuardia} style={{ width: 'auto', padding: '10px 24px' }}>
                {editingId ? 'Aggiorna' : 'Salva'}
              </button>
            </div>
          </div>
        </div>
      )}

      <div className="card">
        <table className="table">
          <thead>
            <tr>
              <th>Nome</th>
              <th>Cognome</th>
              <th>PIN</th>
              <th>Azioni</th>
            </tr>
          </thead>
          <tbody>
            {guardie.map((g) => (
              <tr key={g.id}>
                <td>{g.nome}</td>
                <td>{g.cognome}</td>
                <td>****</td>
                <td>
                  <button onClick={() => modifica(g)} style={{ marginRight: 8 }}>✏️</button>
                  <button onClick={() => elimina(g.id)}>🗑️</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}
