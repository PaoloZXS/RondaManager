import 'package:flutter/material.dart';
import 'package:provider/provider.dart';
import '../models/timbro.dart';
import '../models/turno.dart';
import '../providers/app_state.dart';
import 'timbro_detail_screen.dart';

/// Schermata principale del turno.
/// Mostra lo stato corrente e permette di timbrare NFC,
/// aggiungere note e foto, e completare il turno.
class TurnoScreen extends StatefulWidget {
  const TurnoScreen({super.key});

  @override
  State<TurnoScreen> createState() => _TurnoScreenState();
}

class _TurnoScreenState extends State<TurnoScreen> {
  bool _nfcInAttesa = false;

  @override
  void initState() {
    super.initState();
    // All'avvio, se non c'è un turno attivo, mostra la scelta percorso
    WidgetsBinding.instance.addPostFrameCallback((_) {
      final state = context.read<AppState>();
      if (!state.isInTurno) {
        _mostraSceltaPercorso(state);
      }
    });
  }

  void _mostraSceltaPercorso(AppState state) {
    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (ctx) => AlertDialog(
        title: const Text('Nuovo Turno'),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            const Text('Seleziona il percorso da eseguire:'),
            const SizedBox(height: 16),
            ...state.percorsi.map((percorso) {
              return ListTile(
                leading: const Icon(Icons.route),
                title: Text(percorso.nome),
                subtitle: Text('${percorso.sequenzaPunti.length} punti'),
                onTap: () {
                  Navigator.of(ctx).pop();
                  state.iniziaTurno(percorso.id);
                },
              );
            }),
          ],
        ),
      ),
    );
  }

  Future<void> _leggiNfc() async {
    setState(() => _nfcInAttesa = true);

    try {
      final nfcService = context.read<AppState>();
      // TODO: In produzione, chiamare nfcService per leggere il tag
      // Per ora, simuliamo con un dialog di input manuale
      final idPunto = await _mostraInputPunto();

      if (idPunto != null && mounted) {
        await _elaboraTimbro(idPunto);
      }
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Errore NFC: $e'),
            backgroundColor: Colors.red,
          ),
        );
      }
    }

    if (mounted) setState(() => _nfcInAttesa = false);
  }

  Future<String?> _mostraInputPunto() {
    final controller = TextEditingController();
    return showDialog<String>(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('ID Punto NFC'),
        content: TextField(
          controller: controller,
          decoration: const InputDecoration(
            hintText: 'Inserisci ID punto (simulazione NFC)',
            border: OutlineInputBorder(),
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(ctx).pop(null),
            child: const Text('Annulla'),
          ),
          ElevatedButton(
            onPressed: () => Navigator.of(ctx).pop(controller.text),
            child: const Text('Conferma'),
          ),
        ],
      ),
    );
  }

  Future<void> _elaboraTimbro(String idPunto) async {
    if (!mounted) return;

    // Verifica se è INIZIO o FINE GIRO
    final isInizio = idPunto == 'INIZIO_GIRO';
    final isFine = idPunto == 'FINE_GIRO';

    if (isInizio) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('✅ Inizio giro registrato!'),
          backgroundColor: Colors.green,
        ),
      );
      return;
    }

    if (isFine) {
      final conferma = await showDialog<bool>(
        context: context,
        builder: (ctx) => AlertDialog(
          title: const Text('Fine Giro'),
          content: const Text('Sei sicuro di voler completare il turno?'),
          actions: [
            TextButton(
              onPressed: () => Navigator.of(ctx).pop(false),
              child: const Text('Annulla'),
            ),
            ElevatedButton(
              onPressed: () => Navigator.of(ctx).pop(true),
              child: const Text('Conferma'),
            ),
          ],
        ),
      );

      if (conferma == true && mounted) {
        final state = context.read<AppState>();
        await state.completaTurno();
        if (mounted) {
          ScaffoldMessenger.of(context).showSnackBar(
            const SnackBar(
              content: Text('✅ Turno completato!'),
              backgroundColor: Colors.green,
            ),
          );
          // Ricarica per mostrare scelta nuovo percorso
          _mostraSceltaPercorso(state);
        }
      }
      return;
    }

    // Punto intermedio: chiedi nota/foto
    if (!mounted) return;
    final result = await Navigator.of(context).push<TimbroResult>(
      MaterialPageRoute(
        builder: (_) => TimbroDetailScreen(idPunto: idPunto),
      ),
    );

    if (result != null && mounted) {
      final state = context.read<AppState>();
      await state.registraTimbro(
        idPunto: idPunto,
        nota: result.nota,
        nomeFoto: result.nomeFoto,
      );

      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('✅ Timbro: $idPunto registrato'),
            backgroundColor: Colors.green,
          ),
        );
      }
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('RondaManager'),
        actions: [
          IconButton(
            icon: const Icon(Icons.sync),
            tooltip: 'Sincronizza ora',
            onPressed: () {
              context.read<AppState>().sincronizzaTurni();
            },
          ),
          IconButton(
            icon: const Icon(Icons.logout),
            tooltip: 'Logout',
            onPressed: () async {
              await context.read<AppState>().logout();
              if (mounted) {
                Navigator.of(context).pushReplacement(
                  MaterialPageRoute(
                    builder: (_) => const _RebuildWidget(),
                  ),
                );
              }
            },
          ),
        ],
      ),
      body: Consumer<AppState>(
        builder: (context, state, _) {
          if (state.caricamento) {
            return const Center(child: CircularProgressIndicator());
          }

          final turno = state.turnoCorrente;

          return Column(
            children: [
              // Info guardia
              _buildInfoCard(state),

              // Stato turno
              if (turno != null) _buildTurnoStatus(turno, state),

              // Timeline timbri
              if (turno != null && turno.timbri.isNotEmpty)
                Expanded(child: _buildTimeline(turno.timbri)),

              if (turno != null && turno.timbri.isEmpty)
                const Expanded(
                  child: Center(
                    child: Text(
                      'Nessun timbro ancora registrato.\n'
                      'Avvicina il telefono al tag NFC.',
                      textAlign: TextAlign.center,
                      style: TextStyle(color: Colors.grey),
                    ),
                  ),
                ),

              // Pulsante NFC
              if (turno != null && !turno.completato)
                _buildNfcButton(),
            ],
          );
        },
      ),
    );
  }

  Widget _buildInfoCard(AppState state) {
    return Card(
      margin: const EdgeInsets.all(12),
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Row(
          children: [
            const CircleAvatar(
              child: Icon(Icons.person),
            ),
            const SizedBox(width: 12),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    state.guardiaCorrente?.nomeCompleto ?? 'N/A',
                    style: const TextStyle(
                      fontWeight: FontWeight.bold,
                      fontSize: 16,
                    ),
                  ),
                  if (state.turnoCorrente != null)
                    Text(
                      'Iniziato: ${_formatData(state.turnoCorrente!.dataInizio)}',
                      style: const TextStyle(color: Colors.grey),
                    ),
                ],
              ),
            ),
            if (state.isInTurno)
              const Chip(
                label: Text('IN CORSO'),
                backgroundColor: Colors.green,
                labelStyle: TextStyle(color: Colors.white, fontSize: 12),
              ),
          ],
        ),
      ),
    );
  }

  Widget _buildTurnoStatus(Turno turno, AppState state) {
    final percorso = state.percorsi
        .where((p) => p.id == turno.idPercorso)
        .firstOrNull;

    return Card(
      margin: const EdgeInsets.symmetric(horizontal: 12),
      child: Padding(
        padding: const EdgeInsets.all(12),
        child: Row(
          children: [
            const Icon(Icons.route, color: Colors.indigo),
            const SizedBox(width: 8),
            Expanded(
              child: Text(
                percorso?.nome ?? 'Percorso sconosciuto',
                style: const TextStyle(fontWeight: FontWeight.w500),
              ),
            ),
            Text(
              '${turno.timbri.length} timbri',
              style: const TextStyle(color: Colors.grey),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildTimeline(List<Timbro> timbri) {
    return ListView.builder(
      padding: const EdgeInsets.symmetric(horizontal: 12),
      itemCount: timbri.length,
      itemBuilder: (context, index) {
        final timbro = timbri[index];
        final isLast = index == timbri.length - 1;

        return ListTile(
          leading: CircleAvatar(
            backgroundColor: Colors.indigo,
            child: Text('${index + 1}'),
          ),
          title: Text('Punto: ${timbro.idPunto}'),
          subtitle: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(_formatData(timbro.timestamp)),
              if (timbro.nota != null && timbro.nota!.isNotEmpty)
                Text('Nota: ${timbro.nota}', maxLines: 1),
              if (timbro.nomeFoto != null && timbro.nomeFoto!.isNotEmpty)
                const Row(
                  children: [
                    Icon(Icons.photo, size: 16, color: Colors.grey),
                    SizedBox(width: 4),
                    Text('Foto scattata'),
                  ],
                ),
            ],
          ),
          trailing: timbro.latitudine != null
              ? const Icon(Icons.location_on, size: 18, color: Colors.green)
              : null,
        );
      },
    );
  }

  Widget _buildNfcButton() {
    return SafeArea(
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: SizedBox(
          width: double.infinity,
          height: 60,
          child: ElevatedButton.icon(
            onPressed: _nfcInAttesa ? null : _leggiNfc,
            icon: _nfcInAttesa
                ? const SizedBox(
                    width: 20,
                    height: 20,
                    child: CircularProgressIndicator(strokeWidth: 2),
                  )
                : const Icon(Icons.nfc, size: 28),
            label: Text(
              _nfcInAttesa ? 'Avvicina il tag NFC...' : 'Timbra NFC',
              style: const TextStyle(fontSize: 18),
            ),
            style: ElevatedButton.styleFrom(
              backgroundColor: Colors.indigo,
              foregroundColor: Colors.white,
              shape: RoundedRectangleBorder(
                borderRadius: BorderRadius.circular(12),
              ),
            ),
          ),
        ),
      ),
    );
  }

  String _formatData(DateTime dt) {
    return '${dt.day}/${dt.month}/${dt.year} ${dt.hour.toString().padLeft(2, '0')}:${dt.minute.toString().padLeft(2, '0')}';
  }
}

/// Widget helper per forzare il rebuild.
class _RebuildWidget extends StatelessWidget {
  const _RebuildWidget();

  @override
  Widget build(BuildContext context) {
    return const SizedBox.shrink();
  }
}
