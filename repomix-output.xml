import { useEffect, useState } from 'react';
import { getSupabaseClient } from '../services/supabase';
import { encryptQrConfig, buildQrConfigContent } from '../utils/crypto';
import type { Guardia, Percorso } from '../types';
import QRCode from 'qrcode';

export default function QrCodePage() {
  const [guardie, setGuardie] = useState<Guardia[]>([]);
  const [percorsi, setPercorsi] = useState<Percorso[]>([]);
  const [idTelefono, setIdTelefono] = useState('');
  const [passphrase, setPassphrase] = useState('');
  const [qrDataUrl, setQrDataUrl] = useState('');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');

  useEffect(() => {
    caricaDati();
  }, []);

  async function caricaDati() {
    const supabase = getSupabaseClient();
    const [rGuardie, rPercorsi] = await Promise.all([
      supabase.from('guardie').select('*'),
      supabase.from('percorsi').select('*'),
    ]);
    if (rGuardie.data) setGuardie(rGuardie.data);
    if (rPercorsi.data) setPercorsi(rPercorsi.data);
  }

  async function generaQR() {
    if (!idTelefono.trim()) {
      setError('Inserisci un ID telefono');
      return;
    }
    if (!passphrase.trim()) {
      setError('Inserisci la passphrase offuscata');
      return;
    }
    if (guardie.length === 0) {
      setError('Nessuna guardia configurata');
      return;
    }

    setLoading(true);
    setError('');

    try {

      const content = buildQrConfigContent({
        supabaseUrl: import.meta.env.VITE_SUPABASE_URL,
        supabaseAnonKey: import.meta.env.VITE_SUPABASE_ANON_KEY,
        idTelefono: idTelefono.trim(),
        passphrase: passphrase.trim(),
        guardie,
        percorsi,
      });

      const cifrato = await encryptQrConfig(content);
      const dataUrl = await QRCode.toDataURL(cifrato, {
        width: 400,
        margin: 2,
        color: { dark: '#1a237e', light: '#ffffff' },
      });

      setQrDataUrl(dataUrl);
    } catch (err) {
      setError(`Errore generazione QR: ${err}`);
    } finally {
      setLoading(false);
    }
  }

  function downloadQR() {
    const link = document.createElement('a');
    link.download = `qr-config-${idTelefono}.png`;
    link.href = qrDataUrl;
    link.click();
  }

  return (
    <div>
      <h1>Genera QR Code di Configurazione</h1>
      <p style={{ color: '#666', marginBottom: 24 }}>
        Genera il QR Code da inquadrare con l'app mobile per configurare il telefono.
      </p>

      <div className="card" style={{ maxWidth: 600 }}>
        <div style={{ marginBottom: 16 }}>
          <label style={{ display: 'block', marginBottom: 8, fontWeight: 500 }}>ID Telefono</label>
          <input
            value={idTelefono}
            onChange={(e) => setIdTelefono(e.target.value)}
            placeholder="es. TEL-001"
            style={{ width: '100%', padding: 10, border: '1px solid #ddd', borderRadius: 8 }}
          />
        </div>

        <div style={{ marginBottom: 16 }}>
          <label style={{ display: 'block', marginBottom: 8, fontWeight: 500 }}>
            Passphrase Offuscata
          </label>
          <input
            value={passphrase}
            onChange={(e) => setPassphrase(e.target.value)}
            placeholder="es. nome_cliente_2024_fornitore"
            style={{ width: '100%', padding: 10, border: '1px solid #ddd', borderRadius: 8 }}
          />
          <small style={{ color: '#999' }}>
            Sarà combinata con il segreto hardcoded per generare la chiave AES.
            Scegli una passphrase unica per cliente.
          </small>
        </div>

        <div style={{ marginBottom: 16 }}>
          <p style={{ fontWeight: 500, marginBottom: 8 }}>
            Contenuto del QR Code:
          </p>
          <ul style={{ color: '#666', fontSize: 14 }}>
            <li>Supabase URL e Anon Key</li>
            <li>ID Telefono: <strong>{idTelefono || '❓'}</strong></li>
            <li>{guardie.length} guardie configurate</li>
            <li>{percorsi.length} percorsi configurati</li>
            <li>Passphrase e segreto (cifrati)</li>
          </ul>
        </div>

        {error && <p style={{ color: 'red', marginBottom: 16 }}>{error}</p>}

        <button className="btn-primary" onClick={generaQR} disabled={loading}>
          {loading ? 'Generazione in corso...' : '🎯 Genera QR Code'}
        </button>

        {qrDataUrl && (
          <div style={{ marginTop: 24, textAlign: 'center' }}>
            <img src={qrDataUrl} alt="QR Code Configurazione" style={{ maxWidth: '100%', borderRadius: 8 }} />
            <p style={{ marginTop: 8, fontWeight: 500 }}>ID Telefono: {idTelefono}</p>
            <button className="btn-primary" onClick={downloadQR} style={{ marginTop: 8 }}>
              📥 Scarica QR Code
            </button>
          </div>
        )}
      </div>
    </div>
  );
}
</file>

