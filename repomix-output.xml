import { useEffect, useState } from 'react';
import { getSupabaseClient } from '../services/supabase';
import type { PuntoControllo } from '../types';

export default function PuntiControlloPage() {
  const [punti, setPunti] = useState<PuntoControllo[]>([]);
  const [form, setForm] = useState({
    id: '',
    descrizione: '',
    indirizzo: '',
    is_inizio_giro: false,
    is_fine_giro: false,
  });
  const [editingId, setEditingId] = useState<string | null>(null);
  const [showForm, setShowForm] = useState(false);

  useEffect(() => {
    caricaPunti();
  }, []);

  async function caricaPunti() {
    const supabase = getSupabaseClient();
    const { data } = await supabase.from('punti_controllo').select('*');
    if (data) setPunti(data);
  }

  async function salvaPunto() {
    const supabase = getSupabaseClient();
    const payload = {
      id: form.id,
      descrizione: form.descrizione,
      indirizzo: form.indirizzo,
      is_inizio_giro: form.is_inizio_giro,
      is_fine_giro: form.is_fine_giro,
    };

    if (editingId) {
      await supabase.from('punti_controllo').update(payload).eq('id', editingId);
    } else {
      await supabase.from('punti_controllo').insert(payload);
    }

    resetForm();
    caricaPunti();
  }

  function modifica(p: PuntoControllo) {
    setForm({
      id: p.id,
      descrizione: p.descrizione,
      indirizzo: p.indirizzo,
      is_inizio_giro: p.is_inizio_giro,
      is_fine_giro: p.is_fine_giro,
    });
    setEditingId(p.id);
    setShowForm(true);
  }

  async function elimina(id: string) {
    if (!confirm('Eliminare questo punto di controllo?')) return;
    const supabase = getSupabaseClient();
    await supabase.from('punti_controllo').delete().eq('id', id);
    caricaPunti();
  }

  function resetForm() {
    setForm({ id: '', descrizione: '', indirizzo: '', is_inizio_giro: false, is_fine_giro: false });
    setEditingId(null);
    setShowForm(false);
  }

  return (
    <div>
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 24 }}>
        <h1>Punti di Controllo</h1>
        <button className="btn-primary" onClick={() => { 
          setShowForm(!showForm); 
          if (showForm) resetForm(); 
        }}>
          {showForm ? 'Annulla' : '+ Nuovo Punto'}
        </button>
      </div>

      {showForm && (
        <div className="card" style={{ marginBottom: 24 }}>
          <h3>{editingId ? 'Modifica Punto' : 'Nuovo Punto di Controllo'}</h3>
          <div style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>
            <div style={{ display: 'flex', gap: 12 }}>
              <input
                placeholder="ID (es. NFC001)"
                value={form.id}
                onChange={(e) => setForm({ ...form, id: e.target.value })}
                style={{ flex: 1, padding: 10, border: '1px solid #ddd', borderRadius: 8 }}
              />
              <input
                placeholder="Descrizione"
                value={form.descrizione}
                onChange={(e) => setForm({ ...form, descrizione: e.target.value })}
                style={{ flex: 2, padding: 10, border: '1px solid #ddd', borderRadius: 8 }}
              />
            </div>
            <input
              placeholder="Indirizzo"
              value={form.indirizzo}
              onChange={(e) => setForm({ ...form, indirizzo: e.target.value })}
              style={{ padding: 10, border: '1px solid #ddd', borderRadius: 8 }}
            />

            <div style={{ display: 'flex', gap: 24 }}>
              <label>
                <input
                  type="checkbox"
                  checked={form.is_inizio_giro}
                  onChange={(e) => setForm({ ...form, is_inizio_giro: e.target.checked })}
                />{' '}
                Inizio Giro
              </label>
              <label>
                <input
                  type="checkbox"
                  checked={form.is_fine_giro}
                  onChange={(e) => setForm({ ...form, is_fine_giro: e.target.checked })}
                />{' '}
                Fine Giro
              </label>
            </div>
            <button className="btn-primary" onClick={salvaPunto} style={{ width: 'auto', padding: '10px 24px' }}>
              {editingId ? 'Aggiorna' : 'Salva'}
            </button>
          </div>
        </div>
      )}

      <div className="card">
        <table className="table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Descrizione</th>
              <th>Indirizzo</th>
              <th>Tipo</th>
              <th>Azioni</th>
            </tr>
          </thead>
          <tbody>
            {punti.map((p) => (
              <tr key={p.id}>
                <td><strong>{p.id}</strong></td>
                <td>{p.descrizione}</td>
                <td>{p.indirizzo}</td>
                <td>
                  {p.is_inizio_giro && <span className="badge green">INIZIO</span>}
                  {p.is_fine_giro && <span className="badge red">FINE</span>}
                  {!p.is_inizio_giro && !p.is_fine_giro && <span className="badge gray">INTERMEDIO</span>}
                </td>
                <td>
                  <button onClick={() => modifica(p)} style={{ marginRight: 8 }}>✏️</button>
                  <button onClick={() => elimina(p.id)}>🗑️</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}
