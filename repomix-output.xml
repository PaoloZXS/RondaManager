<file path="web/src/components/ReportViewer.tsx">
import { useEffect, useState } from 'react';
import { getSupabaseClient, listCsvFiles, downloadCsv, BUCKET_CSV } from '../services/supabase';
import { decryptCsv } from '../utils/crypto';
import type { DatoTimbro } from '../types';
import jsPDF from 'jspdf';
import 'jspdf-autotable';

interface Props {
  turnoId: string;
  onClose: () => void;
}

export default function ReportViewer({ turnoId }: Props) {
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [dati, setDati] = useState<DatoTimbro[]>([]);
  const [passphrase, setPassphrase] = useState('');
  const [richiedePassphrase, setRichiedePassphrase] = useState(true);

  useEffect(() => {
    caricaReport();
  }, []);

  async function caricaReport() {
    try {
      setLoading(true);
      const supabase = getSupabaseClient();

      // Cerca i CSV associati a questo turno
      const { data: turno } = await supabase
        .from('turni')
        .select('*')
        .eq('id', turnoId)
        .single();

      if (!turno) {
        setError('Turno non trovato');
        return;
      }

      // Cerca file CSV in tutti i telefoni
      const { data: buckets } = await supabase.storage.from(BUCKET_CSV).list();
      if (!buckets) {
        setError('Nessun file CSV trovato');
        return;
      }

      // Per ogni telefono, cerca i CSV
      for (const bucket of buckets) {
        if (!bucket.id) continue;
        const files = await listCsvFiles(bucket.id);
        // Cerca CSV che contiene l'ID turno
        const matchingFile = files.find((f) => f.includes(turno.id_guardia));
        if (matchingFile) {
          const csvCifrato = await downloadCsv(bucket.id, matchingFile);
          if (richiedePassphrase && passphrase) {
            const decifrato = await decryptCsv(csvCifrato, passphrase);
            const lines = decifrato.split('\n').slice(1); // skip header
            const parsed: DatoTimbro[] = lines
              .filter((l) => l.trim())
              .map((l) => {
                const c = l.split(',');
                return {
                  id: c[0], id_punto: c[1], timestamp: c[2],
                  latitudine: c[3], longitudine: c[4], batteria: c[5],
                  nota: c[6]?.replace(/"/g, ''), nome_foto: c[7],
                  id_guardia: c[8], id_turno: c[9],
                };
              });
            setDati(parsed);
            setRichiedePassphrase(false);
          }
          break;
        }
      }
    } catch (err) {
      setError(`Errore caricamento report: ${err}`);
    } finally {
      setLoading(false);
    }
  }

  async function handleDecifra() {
    setRichiedePassphrase(true);
    setLoading(true);
    await caricaReport();
  }

  function esportaPdf() {
    const doc = new jsPDF();
    doc.setFontSize(16);
    doc.text('Report Turno - RondaManager', 14, 20);
    doc.setFontSize(10);
    doc.text(`Data: ${new Date().toLocaleDateString('it-IT')}`, 14, 28);

    const rows = dati.map((d, i) => [
      i + 1,
      d.id_punto,
      new Date(d.timestamp).toLocaleString('it-IT'),
      d.latitudine || '-',
      d.longitudine || '-',
      `${d.batteria}%`,
      d.nota || '-',
    ]);

    (doc as any).autoTable({
      startY: 35,
      head: [['#', 'Punto', 'Ora', 'Lat', 'Lon', 'Batt', 'Nota']],
      body: rows,
    });

    doc.save(`report-turno-${turnoId.slice(0, 8)}.pdf`);
  }

  if (richiedePassphrase && dati.length === 0) {
    return (
      <div style={{ padding: 24, textAlign: 'center' }}>
        <h3>Decifra Report</h3>
        <p>Inserisci la passphrase offuscata per decifrare i dati:</p>
        <input
          type="password"
          value={passphrase}
          onChange={(e) => setPassphrase(e.target.value)}
          placeholder="Passphrase"
          style={{ padding: 10, border: '1px solid #ddd', borderRadius: 8, width: '100%', marginBottom: 12 }}
        />
        <button className="btn-primary" onClick={handleDecifra}>
          Decifra e Carica
        </button>
      </div>
    );
  }

  if (loading) return <div style={{ padding: 24, textAlign: 'center' }}>Caricamento report...</div>;
  if (error) return <div style={{ padding: 24, color: 'red' }}>{error}</div>;

  return (
    <div>
      <div style={{ marginBottom: 16, display: 'flex', gap: 8 }}>
        <button className="btn-primary" onClick={esportaPdf}>
          📄 Esporta PDF
        </button>
      </div>

      <table className="table">
        <thead>
          <tr>
            <th>#</th>
            <th>Punto</th>
            <th>Data/Ora</th>
            <th>GPS</th>
            <th>Batteria</th>
            <th>Nota</th>
            <th>Foto</th>
          </tr>
        </thead>
        <tbody>
          {dati.map((d, i) => (
            <tr key={d.id}>
              <td>{i + 1}</td>
              <td><strong>{d.id_punto}</strong></td>
              <td>{new Date(d.timestamp).toLocaleString('it-IT')}</td>
              <td style={{ fontSize: 12 }}>
                {d.latitudine ? `${d.latitudine}, ${d.longitudine}` : '-'}
              </td>
              <td>{d.batteria}%</td>
              <td>{d.nota || '-'}</td>
              <td>
                {d.nome_foto ? (
                  <a href="#" onClick={(e) => { e.preventDefault(); alert('Apri foto: ' + d.nome_foto); }}>
                    📷
                  </a>
                ) : '-'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}
</file>

