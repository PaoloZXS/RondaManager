import { useState, useEffect } from 'react';
import { getSupabaseClient, uploadApk, getApkDownloadUrl } from '../services/supabase';
import QRCode from 'qrcode';

export default function ApkPage() {
  const [file, setFile] = useState<File | null>(null);
  const [uploading, setUploading] = useState(false);
  const [apkFileName, setApkFileName] = useState<string | null>(null);
  const [qrDataUrl, setQrDataUrl] = useState('');
  const [message, setMessage] = useState('');

  // URL per download APK (hostato su Vercel insieme al sito)
  const apkUrl = `${window.location.origin}/rondamanager.apk`;

  useEffect(() => {
    caricaUltimoApk();
  }, []);

  async function caricaUltimoApk() {
    try {
      const supabase = getSupabaseClient();
      const { data } = await supabase.storage.from('ronde-apk').list();
      if (data && data.length > 0) {
        // Prende l'ultimo APK caricato
        const ultimo = data.sort((a, b) =>
          (b.created_at ?? '').localeCompare(a.created_at ?? '')
        )[0];
        setApkFileName(ultimo.name);
      }
    } catch {
      // Nessun APK ancora caricato
    }
  }

  async function handleUpload() {
    if (!file) {
      setMessage('Seleziona un file APK');
      return;
    }

    setUploading(true);
    setMessage('');

    try {
      const fileName = await uploadApk(file);
      setApkFileName(fileName);

      const url = getApkDownloadUrl(fileName);
      const dataUrl = await QRCode.toDataURL(url, {
        width: 400,
        margin: 2,
      });
      setQrDataUrl(dataUrl);
      setMessage('✅ APK caricato con successo!');
    } catch (err) {
      setMessage(`❌ Errore: ${err}`);
    } finally {
      setUploading(false);
    }
  }

  return (
    <div>
      <h1>Distribuzione APK</h1>
      <p style={{ color: '#666', marginBottom: 24 }}>
        Carica l'APK dell'app mobile su Supabase Storage.
        Il sistema genera un QR Code per il download e l'installazione.
      </p>

      <div className="card" style={{ maxWidth: 600 }}>
        <h3>Carica Nuova Versione</h3>

        <div style={{ marginBottom: 16 }}>
          <input
            type="file"
            accept=".apk"
            onChange={(e) => setFile(e.target.files?.[0] ?? null)}
            style={{ marginBottom: 8 }}
          />
          {file && (
            <p style={{ fontSize: 14, color: '#666' }}>
              File: {file.name} ({(file.size / 1024 / 1024).toFixed(1)} MB)
            </p>
          )}
        </div>

        <button
          className="btn-primary"
          onClick={handleUpload}
          disabled={uploading || !file}
        >
          {uploading ? '⏳ Caricamento...' : '📤 Carica APK'}
        </button>

        {message && (
          <p style={{ marginTop: 12, color: message.startsWith('✅') ? 'green' : 'red' }}>
            {message}
          </p>
        )}
      </div>

      {qrDataUrl && (
        <div className="card" style={{ maxWidth: 600, marginTop: 24, textAlign: 'center' }}>
          <h3>QR Code di Installazione</h3>
          <p style={{ color: '#666', marginBottom: 16 }}>
            Inquadra questo QR Code con il telefono per scaricare e installare l'APK.
          </p>
          <img
            src={qrDataUrl}
            alt="QR Code Download APK"
            style={{ maxWidth: '100%', borderRadius: 8 }}
          />
          <p style={{ marginTop: 12, fontSize: 14, color: '#666' }}>
            File: {apkFileName}
          </p>
        </div>
      )}

      {apkFileName && !qrDataUrl && (
        <div className="card" style={{ maxWidth: 600, marginTop: 24 }}>
          <p>Ultimo APK caricato: <strong>{apkFileName}</strong></p>
          <button
            className="btn-primary"
            onClick={async () => {
              const url = getApkDownloadUrl(apkFileName);
              const dataUrl = await QRCode.toDataURL(url, { width: 400 });
              setQrDataUrl(dataUrl);
            }}
          >
            🎯 Genera QR Code
          </button>
        </div>
      )}

      {/* Download locale dalla rete */}
      <div className="card" style={{ maxWidth: 600, marginTop: 24, textAlign: 'center' }}>
          <h3>Download APK</h3>
        <p style={{ color: '#666', marginBottom: 16 }}>
          QR Code per scaricare l'APK direttamente sul telefono.
        </p>
        <button
          className="btn-primary"
          onClick={async () => {
            const dataUrl = await QRCode.toDataURL(apkUrl, { width: 400, margin: 2 });
            setQrDataUrl(dataUrl);
            setApkFileName('rondamanager.apk');
          }}
        >
          🎯 Genera QR Download APK
        </button>
      </div>
    </div>
  );
}
</file>

